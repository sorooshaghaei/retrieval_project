#################################
# OS / system
#################################
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd

#################################
# Python
#################################
__pycache__/
*.py[cod]
*$py.class

# Packaging / builds
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

#################################
# Virtual environments
#################################
.venv/
.venv
venv/
env/
ENV/
src/.venv

#################################
# Jupyter
#################################
.ipynb_checkpoints/
**/.ipynb_checkpoints/
notebooks/**/*.csv

#################################
# Tests / coverage
#################################
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

#################################
# Type checkers / linters
#################################
.mypy_cache/
.pyright/
.pytype/
.pyre/
.ruff_cache/

#################################
# Logs
#################################
*.log
pip-log.txt

#################################
# IDEs / editors
#################################
.vscode/
.idea/
*.swp
*.swo

#################################
# Secrets / env files
#################################
.env
.env.*
!.env.example

#################################
# Data (DO NOT COMMIT)
#################################
# Ignore everything under data, but keep folder structure
data/**
!data/.gitkeep
!data/**/.gitkeep

#################################
# Common ML outputs (usually huge)
#################################
outputs/
results/
cache/
runs/
models/
checkpoints/
wandb/
mlruns/
lightning_logs/
tensorboard/

#################################
# Report temp files
#################################
report/~$*

# LaTeX (optional)
report/**/*.aux
report/**/*.bbl
report/**/*.blg
report/**/*.log
report/**/*.out
report/**/*.toc
report/**/*.synctex.gz
report/**/*.fdb_latexmk
report/**/*.fls
report/build/

#################################
# Keep notebooks and reports
#################################
!notebooks/
!notebooks/**/*.ipynb
!report/
!report/**/*.ipynb
!report/**/*.md
!report/**/*.pdf

scores/
solutions_SeaFour.csv
